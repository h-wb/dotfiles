# Per-machine values, untracked (gitignored). mise loads mise.local.toml
# automatically and it overrides everything, so this is the highest-precedence
# source for [vars].
#
# WHY THIS EXISTS
# Templated dotfiles read {{ vars.x }} and never name a source. mise.toml
# defaults every one of those vars to `get_env(...)`, which is the macOS path:
# `fnox exec` injects the ProtonPass secrets and the templates pick them up. On a
# machine where you would rather pin a literal than reach for Proton Pass, put it
# here instead. (The neko container runs fnox too, via PROTON_PASS_KEY_PROVIDER=fs;
# this file still wins over it.)
# Same templates, same var names, different source.
#
# A var that is neither in the environment nor here renders empty, and the
# templates gate their blocks on that, so a partial file is always safe.
#
# On the neko container there is a third option that needs no file at all: add
# the value to the `neko` BWS secret, which arrives as a real environment
# variable via envFrom — get_env() then finds it exactly like fnox's. Prefer that
# for anything genuinely secret; this file is plaintext on the PVC.

[vars]
git_email = "you@example.com"

# Which cluster resolves the internal DNS zone. Written by `mise run dns:edge` /
# `dns:main` rather than by hand — only one cluster can serve that zone at a time
# (see conf.d/k8s-dns.personal.toml). Unset means "main". This is the one var here
# that is a persistent CHOICE rather than a per-machine secret value: it lives in
# this file because it must survive `mise run apply`, and mise.local.toml is the
# one source that outranks both the default and $K8S_DNS_CLUSTER.
# k8s_dns_cluster = "edge"

# Consumed by home/ssh/config.tmpl — the Host block is skipped when unset.
# ssh_truenas_host = "truenas.lan"
# ssh_truenas_user = "you"

# Whole-file WireGuard config (macOS only; see mise.personal.toml).
# wg0_home_conf = """
# [Interface]
# ...
# """
