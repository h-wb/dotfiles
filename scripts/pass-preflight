#!/bin/sh
# Exit 0 only with a live Proton Pass session; every bootstrap with secrets
# runs this first. (A dead session is just a fnox WARN, and the secret-gated
# dotfiles would render EMPTY over the good copies.)
# Tries: the stored session, PASS_CLI_PAT (no TTY needed), then an interactive
# `pass-cli login` unless DOTFILES_NO_LOGIN is set or stdin is not a TTY.
set -u

MISE="${MISE:-$HOME/.local/bin/mise}"

# pass-cli is a [tools] entry, so it may not be installed yet on a fresh machine.
pass_cli() {
	if command -v pass-cli >/dev/null 2>&1; then
		pass-cli "$@"
	elif [ -x "$MISE" ] && P="$("$MISE" which pass-cli 2>/dev/null)" && [ -x "$P" ]; then
		"$P" "$@"
	elif [ -x "$MISE" ]; then
		"$MISE" exec github:protonpass/pass-cli -- pass-cli "$@"
	else
		return 127
	fi
}

# `info`, not `test`: `test` was removed in pass-cli 2.3, and failing as an
# unknown argument looks exactly like "no session".
session() { PASS_LOG_LEVEL=error pass_cli info >/dev/null 2>&1; }

session && exit 0

# Create one with `pass-cli personal-access-token create` on a logged-in machine.
if [ -n "${PASS_CLI_PAT:-}" ]; then
	if PASS_LOG_LEVEL=error pass_cli login --pat "${PASS_CLI_PAT}" >/dev/null 2>&1; then
		echo "[preflight] logged in with PASS_CLI_PAT." >&2
		exit 0
	fi
	echo "[preflight] PASS_CLI_PAT was rejected (expired or revoked?)." >&2
fi

if [ -n "${DOTFILES_NO_LOGIN:-}" ] || [ ! -t 0 ]; then
	echo "[preflight] no Proton Pass session — set PASS_CLI_PAT or run \`pass-cli login\`." >&2
	exit 1
fi

echo "[preflight] no Proton Pass session — starting \`pass-cli login\`." >&2
pass_cli login || { echo "[preflight] login failed." >&2; exit 1; }
session && { echo "[preflight] session established." >&2; exit 0; }
echo "[preflight] still no usable session after login." >&2
exit 1
