#!/bin/sh
# Make this repo mise's config dir: ~/.config/mise -> ~/.dotfiles, and pick the
# machine class in ~/.config/mise/miserc.local.toml (untracked).
#
# mise then reads config.toml, config.<env>.toml, conf.d/ and the committed
# miserc.toml from the repo under their native names, and relative dotfile
# sources resolve inside it. Shared by install.sh and the neko container's
# session-start script (a fresh PVC has not run the installer).
#
# Idempotent. DOTFILES_ENV overrides the auto-detected machine class.
set -eu

DOTFILES_DIR="${DOTFILES_DIR:-${HOME}/.dotfiles}"
CONFIG_DIR="${HOME}/.config/mise"
mkdir -p "${HOME}/.config"

# One-time migration from the old layout, where ~/.config/mise was a real
# directory of per-file symlinks: keep its env selection, park the rest.
if [ -d "${CONFIG_DIR}" ] && [ ! -L "${CONFIG_DIR}" ]; then
	old_env="$(sed -n 's/^env *= *//p' "${CONFIG_DIR}/miserc.toml" 2>/dev/null | head -1)"
	backup="${CONFIG_DIR}.pre-wire.$(date +%Y%m%d%H%M%S)"
	mv "${CONFIG_DIR}" "${backup}"
	echo "[wire] moved the old ~/.config/mise to ${backup}"
	if [ -n "${old_env}" ] && [ ! -f "${DOTFILES_DIR}/miserc.local.toml" ]; then
		printf 'env = %s\n' "${old_env}" >"${DOTFILES_DIR}/miserc.local.toml"
	fi
fi
ln -sfn "${DOTFILES_DIR}" "${CONFIG_DIR}"

# The old per-machine values file kept its project-config name.
if [ -f "${DOTFILES_DIR}/mise.local.toml" ] && [ ! -f "${DOTFILES_DIR}/config.local.toml" ]; then
	mv "${DOTFILES_DIR}/mise.local.toml" "${DOTFILES_DIR}/config.local.toml"
	echo "[wire] renamed mise.local.toml -> config.local.toml"
fi

if [ ! -f "${DOTFILES_DIR}/miserc.local.toml" ]; then
	if [ -z "${DOTFILES_ENV:-}" ]; then
		if [ -d /etc/neko ]; then
			DOTFILES_ENV=neko # baked into the neko image
		elif grep -qx 'ID=cachyos' /etc/os-release 2>/dev/null; then
			DOTFILES_ENV=cachyos
		elif [ "$(uname)" = "Darwin" ]; then
			DOTFILES_ENV=personal
		else
			echo "[wire] unknown machine; set DOTFILES_ENV=personal|neko|cachyos" >&2
			exit 1
		fi
	fi
	printf '# Machine class for this checkout (untracked). See miserc.toml.\nenv = ["%s"]\n' \
		"${DOTFILES_ENV}" >"${DOTFILES_DIR}/miserc.local.toml"
	echo "[wire] machine class: ${DOTFILES_ENV}"
fi
