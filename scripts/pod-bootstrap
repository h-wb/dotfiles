#!/bin/sh
# Provision a pod (layer `pod`) whose only persistent state is $HOME:
#   pod-bootstrap ENVIRONMENT        (a set from miserc.toml, then any layers)
# home-ops' dotfiles Component checks out the cluster's pinned commit in the
# ~/.dotfiles git clone at every pod start, then runs this by path; this
# script never fetches.
# It runs `mise bootstrap` as ENVIRONMENT (--save-env keeps the declaration in
# miserc.local.toml for the pod's shells) in one of three modes:
#   secrets  live Proton Pass session (the pod's token logs in without a TTY)
#   fresh    no session and no secret-derived content to lose
#   protect  no session and secrets on disk: skip dotfiles, or they render empty
#
# What it owns on the volume: ~/.dotfiles (moved to the pin by the Component
# at every start, local changes stashed: develop in ~/Repositories/dotfiles),
# the files the environment's [dotfiles] and [bootstrap] entries name, and
# ~/.local/state/pod-bootstrap.{log,status}. [bootstrap.repos] are cloned when
# missing and never touched after. Anything else is left alone.
#
# Only the status line goes to stdout: a pod's own log is readable by the
# agents' cluster tools, and a failing tool may print what it was rendering.
# The status file is `RESULT MODE DATE COMMIT`; RESULT is ok, degraded (no
# secrets), error, or stale (the commit differs from DOTFILES_REF).
# Exit 0 only on ok.
set -u

DOTFILES="${HOME}/.dotfiles"
STATE="${HOME}/.local/state"
LOG="${STATE}/pod-bootstrap.log"
STATUS="${STATE}/pod-bootstrap.status"
TIMEOUT=1500

[ $# -eq 1 ] || { echo "usage: pod-bootstrap ENVIRONMENT" >&2; exit 2; }

# Outer run: everything to the log on the PVC, the status line to stdout.
if [ -z "${POD_BOOTSTRAP_INNER:-}" ]; then
	mkdir -p "$STATE"
	rm -f "$STATUS"
	POD_BOOTSTRAP_INNER=1 sh "$0" "$@" >>"$LOG" 2>&1
	echo "pod-bootstrap: $(cat "$STATUS" 2>/dev/null || echo 'error none (no status)'); log: $LOG"
	grep -q '^ok ' "$STATUS" 2>/dev/null
	exit
fi

MODE=none
COMMIT="$(git -C "$DOTFILES" rev-parse HEAD 2>/dev/null)" || COMMIT=
[ -n "$COMMIT" ] || COMMIT=unknown
status() { echo "$1 ${MODE} $(date -Is) ${COMMIT}" >"$STATUS"; }
fail() { echo "[error] $*"; status error; exit 1; }

echo "=== $(date -Is) pod start: $1 at ${COMMIT} ==="
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

[ -f "${DOTFILES}/miserc.toml" ] || fail "no ${DOTFILES} checkout"
cd "$DOTFILES" || fail "cannot enter ${DOTFILES}"
. "${DOTFILES}/scripts/provision.sh"

use_env "$1" || fail "environment '$1' not usable"
ensure_mise || fail "mise is not usable"

# The checkout directly: on a fresh PVC the ~/.config/mise link doesn't exist yet.
export MISE_CONFIG_DIR="$DOTFILES"

# `mise exec`, as install.sh: fnox and pass-cli installed on demand (a fresh
# volume has neither), under the environment's [env] (PROTON_PASS_KEY_PROVIDER
# above all). The pod's one token (PROTON_PASS_TOKEN, what repos' `pass:login`
# reads) is also what logs the default session in.
set -- "$MISE" exec github:jdx/fnox github:protonpass/pass-cli --
if PASS_CLI_PAT="${PASS_CLI_PAT:-${PROTON_PASS_TOKEN:-}}" DOTFILES_NO_LOGIN=1 "$@" ./scripts/pass-preflight; then
	MODE=secrets
elif ! grep -q "^Host " "${HOME}/.ssh/config" 2>/dev/null &&
	[ ! -s "${HOME}/.kube/main.yaml" ] && [ ! -s "${HOME}/.kube/edge.yaml" ]; then
	MODE=fresh
else
	MODE=protect
fi

# --save-env: written before anything is applied, so a failed run still
# leaves the pod's shells on its own environment.
# --skip-dirty: one repo with uncommitted work would fail the whole run.
# --force-dotfiles: an app may write its own copy first (fish's config.fish).
# --locked: never rewrite mise.lock / its sidecars — they are committed at locks/.
echo "[info] mode: ${MODE}"
case "$MODE" in
secrets) set -- "$@" fnox --if-missing error exec -c fnox.toml -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty --locked --save-env ;;
fresh) set -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty --locked --save-env ;;
protect) set -- "$MISE" bootstrap --yes --skip dotfiles --skip-dirty --locked --save-env ;;
esac
timeout "$TIMEOUT" "$@" || fail "bootstrap failed in mode ${MODE}"

case "$MODE" in
secrets) echo "[ok] bootstrap applied with secrets" ;;
fresh) echo "[warn] bootstrap applied without a Proton Pass session" ;;
protect) echo "[warn] no Proton Pass session — secret-backed dotfiles were left alone" ;;
esac
if [ -n "${DOTFILES_REF:-}" ] && [ "$DOTFILES_REF" != "$COMMIT" ]; then
	echo "[warn] applied ${COMMIT}, not the pinned ${DOTFILES_REF} (the fetch failed?)"
	status stale
	exit 1
fi
[ "$MODE" = secrets ] || { status degraded; exit 1; }
status ok
