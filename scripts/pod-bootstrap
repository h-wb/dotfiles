#!/bin/sh
# Provision a pod (layer `pod`) whose only persistent state is $HOME:
#   pod-bootstrap ENVIRONMENT        (a set from miserc.toml, then any layers)
# home-ops' dotfiles Component puts the cluster's pinned commit at ~/.dotfiles,
# fresh, at every pod start, then runs this by path; this script never fetches.
# It declares ENVIRONMENT in miserc.local.toml, then runs `mise bootstrap` (at
# most twice) in one of three modes:
#   secrets  live Proton Pass session (the pod's token logs in without a TTY)
#   fresh    no session and no secret-derived content to lose
#   protect  no session and secrets on disk: skip dotfiles, or they render empty
#
# What it owns on the volume: ~/.dotfiles (replaced by the Component at every
# start: edits there do not survive; develop in ~/Repositories/dotfiles; a git
# clone from before the pin is kept once at ~/.dotfiles.pre-pin), the
# files the environment's [dotfiles] and [bootstrap] entries name, and
# ~/.local/state/pod-bootstrap.{log,status}. [bootstrap.repos] are cloned when
# missing and never touched after. Anything else is left alone; the doctor's
# `pod-bootstrap` check flags what earlier bootstraps left behind.
#
# ~/.pod-hold parks it: present, nothing runs (a pod held mid-surgery comes
# back held). Only the status line goes to stdout: a pod's own log is readable
# by the agents' cluster tools, and a failing tool may print what it was
# rendering. The status file is `RESULT MODE DATE COMMIT`; RESULT is ok, error,
# or stale (applied, but not the commit the Component asked for in DOTFILES_REF).
# Exit 0 only on ok.
set -u

DOTFILES="${HOME}/.dotfiles"
STATE="${HOME}/.local/state"
LOG="${STATE}/pod-bootstrap.log"
STATUS="${STATE}/pod-bootstrap.status"
HOLD="${HOME}/.pod-hold"
TIMEOUT=1500

[ $# -eq 1 ] || { echo "usage: pod-bootstrap ENVIRONMENT" >&2; exit 2; }

# Outer run: everything to the log on the PVC, the status line to stdout.
if [ -z "${POD_BOOTSTRAP_INNER:-}" ]; then
	mkdir -p "$STATE"
	rm -f "$STATUS"
	POD_BOOTSTRAP_INNER=1 sh "$0" "$@" >>"$LOG" 2>&1
	echo "pod-bootstrap: $(cat "$STATUS" 2>/dev/null || echo 'error none (no status)'); log: $LOG"
	grep -q '^ok ' "$STATUS" 2>/dev/null
	exit
fi

MODE=none
COMMIT="$(cat "${DOTFILES}/.pinned-commit" 2>/dev/null || echo unpinned)"
status() { echo "$1 ${MODE} $(date -Is) ${COMMIT}" >"$STATUS"; }
fail() { echo "[error] $*"; status error; exit 1; }

echo "=== $(date -Is) pod start: $1 at ${COMMIT} ==="
export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

[ -f "${DOTFILES}/miserc.toml" ] || fail "no ${DOTFILES} checkout"
cd "$DOTFILES" || fail "cannot enter ${DOTFILES}"
. "${DOTFILES}/scripts/provision.sh"

# First: a later failure or a hold still leaves the pod's terminals on its own environment.
declare_env "$DOTFILES" "$1" || fail "environment '$1' not declared"
if [ -e "$HOLD" ]; then
	echo "[hold] ${HOLD} present — skipping. Remove it and restart the pod to resume."
	MODE=hold
	status ok
	exit 0
fi
ensure_mise || fail "mise is not usable"

# The checkout directly: on a fresh PVC the ~/.config/mise link doesn't exist yet.
export MISE_CONFIG_DIR="$DOTFILES"
# The environment's [env] (PROTON_PASS_KEY_PROVIDER above all) before pass-preflight.
eval "$("$MISE" env --shell bash 2>/dev/null)" || true

# The pod's one token (PROTON_PASS_TOKEN, what repos' `pass:login` reads) is
# also what logs the default session in.
PAT="${PASS_CLI_PAT:-${PROTON_PASS_TOKEN:-}}"

pick_mode() {
	FNOX="$("$MISE" which fnox 2>/dev/null || true)"
	if [ -n "$FNOX" ] && [ -x "$FNOX" ] &&
		PASS_CLI_PAT="$PAT" DOTFILES_NO_LOGIN=1 "${DOTFILES}/scripts/pass-preflight"; then
		MODE=secrets
	elif ! grep -q "^Host " "${HOME}/.ssh/config" 2>/dev/null &&
		[ ! -s "${HOME}/.kube/main.yaml" ] && [ ! -s "${HOME}/.kube/edge.yaml" ]; then
		MODE=fresh
	else
		MODE=protect
	fi
}

# --skip-dirty: one repo with uncommitted work would fail the whole run.
# --force-dotfiles: an app may write its own copy first (fish's config.fish).
# --locked: never rewrite mise.lock / its sidecars — they are committed at locks/.
run_bootstrap() {
	echo "[info] mode: ${MODE}"
	case "$MODE" in
	secrets) set -- "$FNOX" --if-missing error exec -c fnox.toml -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty --locked ;;
	fresh) set -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty --locked ;;
	protect) set -- "$MISE" bootstrap --yes --skip dotfiles --skip-dirty --locked ;;
	esac
	timeout "$TIMEOUT" "$@"
}

pick_mode
run_bootstrap || fail "bootstrap failed in mode ${MODE}"
# The first run installs fnox: with a token that works, apply the secrets now
# rather than at the next pod start.
if [ "$MODE" = fresh ] && [ -n "$PAT" ]; then
	pick_mode
	[ "$MODE" != secrets ] || run_bootstrap || fail "bootstrap failed in mode ${MODE}"
fi

case "$MODE" in
secrets) echo "[ok] bootstrap applied with secrets" ;;
fresh) echo "[ok] bootstrap applied without secrets (no PROTON_PASS_TOKEN, or it was rejected)" ;;
protect) echo "[warn] no Proton Pass session — dotfiles SKIPPED to protect existing copies" ;;
esac
if [ -n "${DOTFILES_REF:-}" ] && [ "$DOTFILES_REF" != "$COMMIT" ]; then
	echo "[warn] applied ${COMMIT}, not the pinned ${DOTFILES_REF} (the fetch failed?)"
	status stale
	exit 1
fi
status ok
