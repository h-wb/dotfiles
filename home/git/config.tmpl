[user]
	name = {{ vars.git_name }}
	email = {{ vars.git_email }}
[alias]
	a = add
	ap = add -p
	amc = am --continue
	b = branch
	bm = branch --merged
	bnm = branch --no-merged
	c = clone
	ca = commit --amend
	cane = commit --amend --no-edit
	cf = commit --fixup
	cm = commit --message
	co = checkout
	cob = checkout -b
	com = checkout master
	cp = cherry-pick
	d = diff
	dc = diff --cached
	dom = diff origin/master
	fo = fetch origin
	g = grep --line-number
	mbhom = merge-base HEAD origin/master
	mff = merge --ff-only
	ol = log --pretty=oneline
	l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	p = push
	pf = push --force-with-lease
	prb = pull --rebase
	r = restore
	ra = rebase --abort
	rc = rebase --continue
	ri = rebase --interactive
	rl = reflog
	riom = rebase --interactive origin/master
	rpo = remote prune origin
	s = status -sb
	ss = commit --message snapshot --no-gpg-sign
	su = submodule update
	wd = diff --patience --word-diff
[init]
	defaultBranch = main
{#- By class, as miserc.toml picks it (and miserc.local.toml pins it). #}
{% if 'neko' in mise_env %}
# neko: token from Proton Pass on demand (conf.d/neko/bin/git-credential-fnox).
[credential "https://github.com"]
	helper = {{ env.HOME }}/.local/bin/git-credential-fnox
{% elif 'paseo' in mise_env %}
# paseo: on the general pod gh reads the bot-tintin token from the read-only
# hosts.yml home-ops mounts at $GH_CONFIG_DIR (no personal-token fallback).
[credential "https://github.com"]
	helper = !gh auth git-credential
# ~/.dotfiles is an emptyDir, and its mount point belongs to root.
[safe]
	directory = {{ env.HOME }}/.dotfiles
{% elif 'code-server' in mise_env %}
# code-server: the owner's own `gh auth login`. By path: the editor's own git
# runs without the shell's PATH, so `gh` alone is not found there.
[credential "https://github.com"]
	helper = !{{ env.HOME }}/.local/share/mise/shims/gh auth git-credential
{% elif os() == "linux" %}
[credential]
	helper = store
{% endif %}
