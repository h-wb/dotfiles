#!/bin/sh
# Starts the Prefect worker for the `macbook-pool` process pool. Run by the
# dev.mise.prefect-worker LaunchAgent under `fnox exec`, so PREFECT_API_URL and
# PREFECT_API_AUTH_STRING arrive in the environment from Proton Pass.
#
# This is a script rather than more shell crammed into the launchd args because
# the URL normalisation below needs a `case`, and mise passes agent args through
# without templating (see CLAUDE.md #1).
set -u

VENV="${HOME}/.local/share/prefect-worker/venv"
# Deliberately NOT exporting VIRTUAL_ENV. It used to point here so the deployments'
# `uv pip install .` pull step would resolve, but that aimed the install at the
# worker's own venv: flow dependencies landed on top of the worker, and a project
# pinning a different prefect (h-wb/pipelines pins 3.4.22 vs the 3.6.7 the cluster
# server runs) would silently downgrade the running worker.
#
# Each deployment owns its venv instead. In prefect.yaml, build it in the pull step
# and point the run at it:
#
#   pull:
#   - prefect.deployments.steps.git_clone: { id: clone-step, repository: ... }
#   - prefect.deployments.steps.run_shell_script:
#       directory: "{{ clone-step.directory }}"
#       script: uv venv .venv && uv pip install --python .venv/bin/python .
#   deployments:
#   - work_pool:
#       job_variables:
#         command: .venv/bin/python -m prefect.engine
#
# This venv therefore holds only `prefect` (plus importlib_metadata, see mise.toml)
# and stays stable no matter what flows install.
export PATH="${VENV}/bin:${HOME}/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin"

case "${PREFECT_API_URL:-}" in
"")
	echo "[error] PREFECT_API_URL is empty — is this running under \`fnox exec\`?" >&2
	exit 1
	;;
# The Proton Pass item holds the site URL, but Prefect's client wants the API
# root. Without /api every request lands on the OAuth2 login page in front of
# the ingress, and the worker dies parsing HTML as JSON. Normalising here means
# the stored secret can hold either form.
*/api | */api/) ;;
*) PREFECT_API_URL="${PREFECT_API_URL%/}/api" ;;
esac
export PREFECT_API_URL

# --type process creates the work pool when the server does not have it yet.
# Without it the worker exits on a missing pool, which is how it crash-looped.
exec prefect worker start --pool macbook-pool --type process
