#!/bin/sh
# Re-provision the neko container at every XFCE session start.
#
# This is the launchd equivalent for a box that has no launchd and no systemd:
# ~/.config/autostart/mise-bootstrap.desktop runs it when the XFCE session comes
# up. It has to exist because only /home/neko is on a PVC — /usr and /etc are
# image state, so every pod roll loses the apt packages and the login shell,
# while $HOME (mise, [tools], dotfiles, ~/.local/opt) comes back intact.
#
# It is also just a normal script: run `neko-bootstrap` by hand any time.
set -u

LOG="${HOME}/.local/state/neko-bootstrap.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== $(date -Is) session start ==="

export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

# X server side of "never blank": there is nobody at this screen to wake it, and
# a blanked display just streams black. The xfce daemons are handled by neko:xfce.
[ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1 && xset s off -dpms || true

# mise itself lives on the PVC, but reinstall it if the volume is ever new.
if ! command -v mise >/dev/null 2>&1; then
	echo "[info] installing mise"
	curl -fsSL https://mise.run | sh
fi
MISE="${HOME}/.local/bin/mise"

# ProtonPass ssh-agent, the pass-cli-ssh-agent LaunchAgent's counterpart. The
# socket file is on the PVC and outlives the process, so a stale one is always
# left over from the previous container — remove it before starting.
SOCK="${HOME}/.ssh/proton-pass-agent.sock"
# On a fresh PVC ~/.ssh does not exist yet, and the redirect below fails with
# "Directory nonexistent" before the agent ever starts.
mkdir -p "${HOME}/.ssh" && chmod 700 "${HOME}/.ssh"
if PASS_CLI="$("$MISE" which pass-cli 2>/dev/null)" && [ -x "$PASS_CLI" ]; then
	rm -f "$SOCK"
	PASS_LOG_LEVEL=error nohup "$PASS_CLI" ssh-agent start --socket-path "$SOCK" \
		>>"${HOME}/.ssh/proton-pass-agent.log" 2>&1 &
	echo "[info] started pass-cli ssh-agent"
fi

[ -d "${HOME}/.dotfiles" ] || { echo "[warn] no ~/.dotfiles; nothing to apply"; exit 0; }
cd "${HOME}/.dotfiles" || exit 0

# On a fresh PVC nobody has run install.sh, so mise has no global config dir yet
# — without this the conf.d fragments never load and the neko:* tasks do not
# exist. Idempotent, so it is cheap to redo on every session start.
"${HOME}/.dotfiles/scripts/link-mise-config"

# Prefer the fnox path so secret-gated dotfiles render, but never let it hold up
# the session: if the Proton Pass session has expired, fnox cannot prompt for a
# login from an autostart script, so fall back to a bare bootstrap (templates
# then render their empty fallback, exactly as on a machine without secrets).
#
# --if-missing error is what makes that fallback reachable at all: fnox's default
# is to WARN on an unresolved secret and carry on with exit 0, so this branch
# used to "succeed" with every secret unset and report that it had applied them.
#
# The fallback then has to SKIP dotfiles. Reaching it means there are no secrets,
# and a full bootstrap would render the secret-gated templates empty straight
# over the good copies (~/.ssh/config loses its hosts, wg0.home.conf truncates to
# 0 bytes) — the same trap scripts/pass-preflight exists to prevent. Everything
# else converges normally.
if DOTFILES_NO_LOGIN=1 "${HOME}/.dotfiles/scripts/pass-preflight" &&
	FNOX="$("$MISE" which fnox 2>/dev/null)" && [ -x "$FNOX" ] &&
	timeout 600 "$FNOX" --if-missing error exec -c fnox.toml -- "$MISE" bootstrap --yes; then
	echo "[ok] bootstrap applied with secrets"
elif [ ! -e "${HOME}/.ssh/config" ] && [ ! -e "${HOME}/.config/wireguard/wg0.home.conf" ] &&
	timeout 600 "$MISE" bootstrap --yes --force-dotfiles; then
	# First boot: the secret-gated targets do not exist yet, so there is nothing to
	# clobber and applying everything is safe. --force-dotfiles because apps write
	# their own defaults before we get here — fish creates ~/.config/fish/config.fish
	# as soon as any fish shell starts, and mise will not replace a regular file with
	# a symlink without it, which fails the whole dotfiles step. Without this a fresh container comes
	# up with NO dotfiles at all — no fish config, no prompt, no terminal settings —
	# just because two of the twelve entries happen to need secrets.
	echo "[ok] bootstrap applied without secrets (first boot; ssh/wireguard stay empty until \`pass-cli login\` + \`mise run apply\`)"
elif timeout 600 "$MISE" bootstrap --yes --skip dotfiles; then
	# Secret-gated files already exist: applying now would render them empty over
	# good copies, so the whole dotfiles step sits out this run.
	echo "[ok] bootstrap applied without secrets — dotfiles SKIPPED to protect existing copies (run \`pass-cli login\`, then \`mise run apply\`)"
else
	echo "[error] bootstrap failed — see above"
	command -v notify-send >/dev/null 2>&1 &&
		notify-send -u critical "neko-bootstrap failed" "see $LOG" || true
	exit 1
fi
