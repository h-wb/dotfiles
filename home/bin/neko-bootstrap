#!/bin/sh
# Re-provision the neko container at every XFCE session start.
#
# This is the launchd equivalent for a box that has no launchd and no systemd:
# ~/.config/autostart/mise-bootstrap.desktop runs it when the XFCE session comes
# up. It has to exist because only /home/neko is on a PVC — /usr and /etc are
# image state, so every pod roll loses the apt packages and the login shell,
# while $HOME (mise, [tools], dotfiles) comes back intact.
#
# Secrets come from Proton Pass, exactly as on the Macs. The container-specific
# part is PROTON_PASS_KEY_PROVIDER=fs (mise.neko.toml), because pass-cli's default
# keyring backend needs add_key(2), which this pod's seccomp profile blocks; and
# PASS_CLI_PAT, because a session start has no TTY to log in through.
#
# It is also just a normal script: run `neko-bootstrap` by hand any time.
set -u

LOG="${HOME}/.local/state/neko-bootstrap.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== $(date -Is) session start ==="

export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

# X server side of "never blank": there is nobody at this screen to wake it, and
# a blanked display just streams black. The xfce daemons are handled by neko:xfce.
[ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1 && xset s off -dpms || true

# mise itself lives on the PVC, but reinstall it if the volume is ever new.
if ! command -v mise >/dev/null 2>&1; then
	echo "[info] installing mise"
	curl -fsSL https://mise.run | sh
fi
MISE="${HOME}/.local/bin/mise"

# Escape hatch. This box is where the dotfiles get edited, and the session-start
# run would happily apply a half-finished config over a working desktop — or
# fight an edit in progress. `touch ~/.neko-hold` stops that until you remove it.
#
# Deliberately checked before anything else, and deliberately a file in $HOME:
# it survives a pod roll, so a desktop parked mid-surgery comes back parked.
if [ -e "${HOME}/.neko-hold" ]; then
	echo "[hold] ~/.neko-hold present — skipping bootstrap entirely."
	echo "[hold] remove it and run \`neko-bootstrap\` (or restart the session) to resume."
	command -v notify-send >/dev/null 2>&1 &&
		notify-send "neko-bootstrap on hold" "~/.neko-hold is present; nothing was applied" || true
	exit 0
fi

[ -d "${HOME}/.dotfiles" ] || { echo "[warn] no ~/.dotfiles; nothing to apply"; exit 0; }
cd "${HOME}/.dotfiles" || exit 0

# On a fresh PVC nobody has run install.sh, so mise has no global config dir yet
# — without this the conf.d fragments never load and the neko:* tasks do not
# exist. Idempotent, so it is cheap to redo on every session start.
"${HOME}/.dotfiles/scripts/link-mise-config"

# Apply mise's [env] to THIS shell. Everything below runs as a plain script, not
# under `mise exec`, so without this the config's env vars simply are not there —
# in particular PROTON_PASS_KEY_PROVIDER=fs, whose absence sends pass-cli back to
# the kernel keyring that seccomp blocks, and the whole secrets path fails with
# no obvious cause.
eval "$("$MISE" env 2>/dev/null)" || true

# Pick the mode first, then run bootstrap exactly ONCE. Chaining the three cases
# on each other's exit status looks tidier but is wrong: an unrelated failure
# (one tool with no asset for this platform) makes a mode that already applied
# the dotfiles look failed, and the next branch re-runs the whole bootstrap.
#
# --skip-dirty: [bootstrap.repos] converges the checkouts on every session start,
# and without it one repo with uncommitted work fails the whole bootstrap — on
# this box that means the desktop silently stops provisioning.
#
# --force-dotfiles where dotfiles are applied: apps write their own defaults
# before we get here (fish creates ~/.config/fish/config.fish on first shell) and
# mise will not replace a regular file with a symlink without it.
#
# DOTFILES_NO_LOGIN so a session start never blocks on a prompt; the preflight
# still logs in non-interactively when PASS_CLI_PAT is set.
FNOX="$("$MISE" which fnox 2>/dev/null || true)"
if [ -n "$FNOX" ] && [ -x "$FNOX" ] &&
	DOTFILES_NO_LOGIN=1 "${HOME}/.dotfiles/scripts/pass-preflight"; then
	MODE=secrets
elif ! grep -q "^Host " "${HOME}/.ssh/config" 2>/dev/null &&
	[ ! -s "${HOME}/.kube/main.yaml" ]; then
	# No session, but nothing to lose. The test is for secret-DERIVED content, not
	# for the files: ~/.ssh/config always exists after one run (the template still
	# emits `HashKnownHosts no`), so keying on existence would pin the box in
	# `protect` forever and freeze every unrelated dotfile with it. The kubeconfig
	# has no such preamble, so -s (non-empty) is the equivalent test there.
	MODE=fresh
else
	# A secret-derived file (ssh Host block, or a non-empty kubeconfig) exists and
	# there is no session to regenerate it: rendering now would blank it.
	MODE=protect
fi

case "$MODE" in
secrets)
	timeout 900 "$FNOX" --if-missing error exec -c fnox.toml -- \
		"$MISE" bootstrap --yes --force-dotfiles --skip-dirty
	STATUS=$?
	[ $STATUS -eq 0 ] && echo "[ok] bootstrap applied with secrets"
	;;
fresh)
	timeout 900 "$MISE" bootstrap --yes --force-dotfiles --skip-dirty
	STATUS=$?
	[ $STATUS -eq 0 ] &&
		echo "[ok] bootstrap applied without secrets (set PASS_CLI_PAT, or run \`pass-cli login\` then \`mise run apply\`)"
	;;
protect)
	timeout 900 "$MISE" bootstrap --yes --skip dotfiles --skip-dirty
	STATUS=$?
	[ $STATUS -eq 0 ] &&
		echo "[warn] no Proton Pass session — dotfiles SKIPPED to protect existing copies"
	;;
esac

if [ "${STATUS:-1}" -ne 0 ]; then
	echo "[error] bootstrap failed in mode '$MODE' — see above"
	command -v notify-send >/dev/null 2>&1 &&
		notify-send -u critical "neko-bootstrap failed" "see $LOG" || true
	exit 1
fi
