#!/bin/sh
# neko-app — install a GUI app into ~/.local/opt so it survives a pod roll.
#
# apt is not an option for these: it writes to /usr, which is image state and is
# wiped every time the pod is rescheduled, so an apt-installed Obsidian would be
# a 300 MB re-download at every container start. ~/.local/opt is on the PVC.
#
#   neko-app <name> <source> <exe> <args> <display name> <categories>
#
# The catalog of apps lives in conf.d/neko-apps.neko.toml, which pipes one line
# per app into `neko-app install`. Called directly it does one app:
#
#   neko-app install obsidian gh:obsidianmd/obsidian-releases:'Obsidian-[0-9.]+\.AppImage' \
#       auto --no-sandbox Obsidian 'Office;TextEditor;'
#
# <source> is one of:
#   url:<url>            a vendor "latest" URL; the redirect is followed to the
#                        real versioned file, and that final URL is what gets
#                        recorded — so a new upstream release changes the URL and
#                        the app reinstalls on the next bootstrap, automatically.
#   gh:<owner/repo>:<re> the newest asset matching <re> across recent releases.
#                        Scanning releases rather than trusting /releases/latest
#                        is deliberate: Obsidian's repo publishes Android builds
#                        as "latest", which have no desktop asset at all.
#
# In both, `{a,b}` expands to a on amd64 and b on arm64 (`|` is the catalog's
# field separator, so the alternation uses a comma).
#
# <exe> is the binary relative to the app dir, or `auto` for an AppImage
# (extracted, never FUSE-mounted: /dev/fuse is not there in a k8s pod).
# <args> is appended to the desktop entry's Exec, or `-` for none. Electron apps
# want --no-sandbox here: Chromium's sandbox needs user namespaces, which an
# unprivileged container does not get.
set -u

OPT="${HOME}/.local/opt"
BIN="${HOME}/.local/bin"
APPS="${HOME}/.local/share/applications"

log() { echo "[neko-app] $*"; }

arch="$(dpkg --print-architecture 2>/dev/null || echo unknown)"
case "${arch}" in
	amd64) pick='s/{\([^{},]*\),\([^{},]*\)}/\1/g' ;;
	arm64) pick='s/{\([^{},]*\),\([^{},]*\)}/\2/g' ;;
	*)
		log "unsupported architecture ${arch}"
		exit 0
		;;
esac

# {a,b} -> the alternative for this architecture
subst() { printf '%s' "$1" | sed "${pick}"; }

resolve_url() {
	_src="$(subst "$1")"
	case "${_src}" in
	url:*)
		# -I follows redirects with -L and prints where it landed; if the vendor
		# does not redirect, url_effective is just the URL we asked for.
		curl -fsSLI -o /dev/null -w '%{url_effective}' --retry 3 --retry-all-errors "${_src#url:}"
		;;
	gh:*)
		_spec="${_src#gh:}"
		_repo="${_spec%%:*}"
		_re="${_spec#*:}"
		curl -fsSL --retry 3 --retry-all-errors \
			"https://api.github.com/repos/${_repo}/releases?per_page=30" |
			sed -n 's/.*"browser_download_url": *"\(https[^"]*\)".*/\1/p' |
			grep -E "/${_re}$" | head -1
		;;
	*)
		log "unknown source kind: ${_src}"
		return 1
		;;
	esac
}

# Best-effort icon: AppImages carry .DirIcon, .debs put one under hicolor, and
# tarballs vary. A missing icon is cosmetic, so fall back to a generic name.
find_icon() {
	_dir="$1"
	_name="$2"
	if [ -f "${_dir}/.DirIcon" ]; then
		# .DirIcon is usually a symlink to a real png; the extension matters to
		# some launchers, so prefer the target when it has one.
		_target="$(readlink -f "${_dir}/.DirIcon" 2>/dev/null || true)"
		case "${_target}" in *.png | *.svg)
			printf '%s' "${_target}"
			return
			;;
		esac
	fi
	_icon="$(find "${_dir}" -maxdepth 6 -type f \( -name '*.png' -o -name '*.svg' \) \
		\( -ipath "*${_name}*" -o -ipath '*icon*' -o -ipath '*pixmaps*' \) 2>/dev/null |
		sort | head -1)"
	[ -n "${_icon}" ] && printf '%s' "${_icon}" || printf 'applications-other'
}

install_app() {
	name="$1"
	source_spec="$2"
	exe="$3"
	args="$4"
	display="$5"
	categories="$6"
	[ "${args}" = "-" ] && args=""

	url="$(resolve_url "${source_spec}")" || url=""
	if [ -z "${url}" ]; then
		log "${name}: could not resolve a download URL (skipped)"
		return 0
	fi

	stamp="${OPT}/${name}/.installed-url"
	if [ "${NEKO_APPS_UPGRADE:-0}" != "1" ] && [ "$(cat "${stamp}" 2>/dev/null || true)" = "${url}" ]; then
		log "${name}: up to date"
	else
		tmp="$(mktemp -d)"
		# strip any query string when naming the file, so the suffix test below
		# sees .AppImage / .tar.xz rather than ...?product=firefox-latest-ssl
		file="${tmp}/$(basename "${url%%\?*}")"
		if ! curl -fsSL --retry 3 --retry-delay 2 --retry-all-errors -o "${file}" "${url}"; then
			log "${name}: download failed (keeping the existing install)"
			rm -rf "${tmp}"
			return 0
		fi

		staging="${tmp}/root"
		mkdir -p "${staging}"
		case "${file}" in
		*.AppImage)
			chmod +x "${file}"
			# --appimage-extract unpacks with the AppImage's own static runtime,
			# so it needs neither FUSE nor privileges.
			(cd "${staging}" && "${file}" --appimage-extract >/dev/null 2>&1) &&
				mv "${staging}/squashfs-root"/* "${staging}/squashfs-root"/.[!.]* "${staging}/" 2>/dev/null
			rmdir "${staging}/squashfs-root" 2>/dev/null || true
			;;
		*.tar.gz | *.tgz) tar -xzf "${file}" -C "${staging}" --strip-components=1 ;;
		*.tar.xz) tar -xJf "${file}" -C "${staging}" --strip-components=1 ;;
		*.tar.bz2) tar -xjf "${file}" -C "${staging}" --strip-components=1 ;;
		*.deb) dpkg-deb -x "${file}" "${staging}" ;;
		*)
			log "${name}: don't know how to unpack $(basename "${file}")"
			rm -rf "${tmp}"
			return 0
			;;
		esac

		if [ ! -d "${staging}" ] || [ -z "$(ls -A "${staging}" 2>/dev/null)" ]; then
			log "${name}: unpacked to nothing (skipped)"
			rm -rf "${tmp}"
			return 0
		fi

		# Only now is the old install replaced: a failed download or a bad
		# archive above leaves the working copy alone.
		rm -rf "${OPT:?}/${name}"
		mkdir -p "${OPT}"
		mv "${staging}" "${OPT}/${name}"
		rm -rf "${tmp}"
		printf '%s\n' "${url}" > "${stamp}"
		log "${name}: installed $(basename "${url%%\?*}")"
	fi

	dir="${OPT}/${name}"
	[ "${exe}" = "auto" ] && exe="AppRun"
	if [ ! -x "${dir}/${exe}" ]; then
		log "${name}: ${exe} is not executable in ${dir} — no launcher written"
		return 0
	fi

	mkdir -p "${BIN}" "${APPS}"
	ln -sf "${dir}/${exe}" "${BIN}/${name}"
	icon="$(find_icon "${dir}" "${name}")"
	cat > "${APPS}/${name}.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=${display}
Exec=${dir}/${exe} ${args} %U
Icon=${icon}
Categories=${categories}
Terminal=false
StartupNotify=true
EOF
}

usage() {
	echo "usage: neko-app install <name> <source> <exe> <args> <display> <categories>" >&2
	echo "       neko-app install-all   # read the same 6 fields, pipe-separated, from stdin" >&2
	exit 64
}

case "${1:-}" in
install)
	shift
	[ $# -eq 6 ] || usage
	install_app "$@"
	;;
install-all)
	# One app per line: name | source | exe | args | display | categories
	while IFS='|' read -r f1 f2 f3 f4 f5 f6; do
		# skip blanks and comments
		case "$(printf '%s' "${f1}" | tr -d ' \t')" in '' | '#'*) continue ;; esac
		install_app \
			"$(printf '%s' "${f1}" | xargs)" "$(printf '%s' "${f2}" | xargs)" \
			"$(printf '%s' "${f3}" | xargs)" "$(printf '%s' "${f4}" | xargs)" \
			"$(printf '%s' "${f5}" | xargs)" "$(printf '%s' "${f6}" | xargs)"
	done
	command -v update-desktop-database > /dev/null 2>&1 &&
		update-desktop-database "${APPS}" 2> /dev/null || true
	;;
*) usage ;;
esac
