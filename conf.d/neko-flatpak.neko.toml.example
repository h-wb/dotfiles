# The flatpak route for GUI apps — mise CAN do this declaratively, and if it
# works in your pod it is strictly better than conf.d/neko-apps.neko.toml:
# real updates, real dependency handling, one line per app.
#
# It is shipped as .example (conf.d only loads *.toml) because it hinges on one
# thing that is a property of your cluster, not of this repo:
#
#     flatpak runs every app through bubblewrap, which needs to create a user
#     namespace. An unprivileged container often cannot.
#
# CHECK FIRST, inside the neko container's terminal:
#
#     unshare -Ur true && echo "userns OK"
#
# If that prints "userns OK", enable this file and delete the app rows from
# conf.d/neko-apps.neko.toml:
#
#     mv conf.d/neko-flatpak.neko.toml.example conf.d/neko-flatpak.neko.toml
#
# If it fails with "Operation not permitted", flatpak cannot work here — the pod
# would need a securityContext with seccompProfile: Unconfined (and a kernel
# allowing unprivileged userns), which is a bigger ask than unpacking tarballs
# into $HOME. Stay on neko-apps.
#
# Two things to know either way:
#   - ~/.local/share/flatpak IS on the PVC, so apps and runtimes persist. But the
#     shared runtimes are large: budget 2-3 GB of PVC for the freedesktop/GNOME
#     platforms before any app.
#   - flatpak apps get a sandboxed home under ~/.var/app/<id>, so an Obsidian
#     vault or VS Code profile lives there, not in ~/.config.

# mise does not install flatpak and does not configure remotes ("mise does not
# install Flatpak or configure remotes implicitly"), and the flatpak-user entries
# below are resolved during the packages step — so the CLI and the flathub remote
# have to exist *before* it. That is why this hook installs flatpak itself
# instead of relying on the "apt:flatpak" line, which lands too late on a fresh
# container. Hooks with the same name accumulate across configs, so this runs
# alongside the apt-update hook in mise.neko.toml rather than replacing it.
[bootstrap.hooks.pre-packages]
run = '''
[ "$(uname)" = "Linux" ] || exit 0
if ! command -v flatpak >/dev/null 2>&1; then
  sudo apt-get install -y -qq --no-install-recommends flatpak
fi
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
'''

[bootstrap.packages]
"apt:flatpak" = "latest"   # declared so it is reinstalled on every pod roll

# --user scope: installs into ~/.local/share/flatpak, which is on the PVC.
"flatpak-user:md.obsidian.Obsidian" = "latest"
"flatpak-user:com.visualstudio.code" = "latest"   # Microsoft's build, not Code-OSS
"flatpak-user:org.mozilla.firefox" = "latest"
"flatpak-user:app.zen_browser.zen" = "latest"
