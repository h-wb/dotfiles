#!/bin/sh
# Provision the paseo agent host at every pod start, from its `tools` init container
# (home-ops agents/paseo); fine to run by hand. Only $HOME survives a pod roll. The
# pod supplies its data scope; home-ops applies the rest of the agent config afterwards.
set -u

export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"
. "${HOME}/.dotfiles/scripts/provision.sh"
ensure_mise || exit 1
pull_dotfiles "${HOME}/.dotfiles/conf.d/paseo/bin/paseo-bootstrap" "$@"

# The checkout directly: on a fresh PVC the ~/.config/mise link doesn't exist yet.
export MISE_CONFIG_DIR="${HOME}/.dotfiles"
# --skip-dirty: an agent's uncommitted work in a repo must not fail the pod start.
# --locked: never rewrite mise.lock / its sidecars — they are committed at locks/;
#   MISE_CONFIG_DIR makes mise write them under .mise/locks/ instead (gitignored).
set -- bootstrap --yes --force-dotfiles --skip-dirty --locked
# Private receives no general GitHub credential. Its Obsidian tooling is copied
# over SSH separately; keep the shared tools/dotfiles without cloning general repos.
if [ "${PASEO_DATA_SCOPE:-general}" = private ]; then
	set -- "$@" --skip repos
fi
"$MISE" "$@" || exit 1

# MISE_CONFIG_DIR makes mise normalise lock sidecar paths from locks/… to
# .mise/locks/… in mise.lock (the sidecars themselves are gitignored). Revert
# so the checkout stays clean for the next pull --ff-only.
git -C "${HOME}/.dotfiles" checkout -- mise.lock mise.*.lock 2>/dev/null || true
