{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm.llm.svc.cluster.local:4000/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-chat": {
          "name": "Qwen3.5 9B no-think (MacBook)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["chrome-devtools-mcp", "--browserUrl", "http://127.0.0.1:9222"]
    }{% if get_env(name="PASEO_DATA_SCOPE", default="") == "general" %},
    "toolhive-general": {
      "type": "remote",
      "url": "https://mcp-general.example.test/mcp",
      "headers": {
        "x-api-key": "{env:MCP_API_KEY}"
      }
    },
    "memini-general": {
      "type": "remote",
      "url": "http://memini-general.llm.svc.cluster.local:8080/mcp",
      "headers": {
        "Authorization": "Bearer {env:MEMINI_API_KEY}"
      }
    }{% endif %}
  }
}
