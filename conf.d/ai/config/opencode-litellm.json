{% if vars.secret_domain %}
{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "openai": {
      "settings": {
        "baseURL": {{ ("https://litellm." ~ vars.secret_domain ~ "/v1") | json_encode }},
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}
{% else %}
{}
{% endif %}
