#!/bin/sh
# Re-provision the neko container at every XFCE session start (run by
# ~/.config/autostart/mise-bootstrap.desktop; fine to run by hand). Only $HOME
# survives a pod roll, so apt packages and /etc are rebuilt each time.
set -u

LOG="${HOME}/.local/state/neko-bootstrap.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1
echo "=== $(date -Is) session start ==="

export PATH="${HOME}/.local/bin:${HOME}/.local/share/mise/shims:${PATH}"

# Never blank the X server (neko:xfce covers the XFCE daemons).
[ -n "${DISPLAY:-}" ] && command -v xset >/dev/null 2>&1 && xset s off -dpms || true

if ! command -v mise >/dev/null 2>&1; then
	echo "[info] installing mise"
	curl -fsSL https://mise.run | sh
fi
MISE="${HOME}/.local/bin/mise"

# self_update.auto skips unattended runs, so honour config.toml's hard
# min_version here or every session start fails. Re-checked after a pull.
MIN_MISE="$(sed -n 's/^min_version = { hard = "\([^"]*\)" }.*/\1/p' "${HOME}/.dotfiles/config.toml" 2>/dev/null)"
have="$("$MISE" --version 2>/dev/null | awk '{print $1}')"
if [ -n "$MIN_MISE" ] &&
	[ "$(printf '%s\n%s\n' "$MIN_MISE" "${have:-0}" | sort -V | head -1)" != "$MIN_MISE" ]; then
	echo "[info] mise ${have:-?} < ${MIN_MISE}; self-updating"
	"$MISE" self-update --yes || echo "[warn] mise self-update failed"
fi

# `touch ~/.neko-hold` parks provisioning (e.g. mid-edit of the dotfiles). A
# file in $HOME, so a desktop parked mid-surgery comes back parked.
if [ -e "${HOME}/.neko-hold" ]; then
	echo "[hold] ~/.neko-hold present — skipping. Remove it and run \`neko-bootstrap\` to resume."
	command -v notify-send >/dev/null 2>&1 &&
		notify-send "neko-bootstrap on hold" "~/.neko-hold is present; nothing was applied" || true
	exit 0
fi

[ -d "${HOME}/.dotfiles" ] || { echo "[warn] no ~/.dotfiles; nothing to apply"; exit 0; }
cd "${HOME}/.dotfiles" || exit 0

# Fast-forward the checkout; git is an apt package, so not back yet on a rolled pod.
if ! command -v git >/dev/null 2>&1; then
	sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends git ||
		echo "[warn] could not install git; dotfiles not updated"
fi
if command -v git >/dev/null 2>&1 && [ -z "${NEKO_BOOTSTRAP_PULLED:-}" ]; then
	before="$(git rev-parse HEAD 2>/dev/null)"
	if timeout 60 git pull --ff-only --quiet; then
		if [ "$(git rev-parse HEAD 2>/dev/null)" != "$before" ]; then
			echo "[info] dotfiles updated ${before} -> $(git rev-parse HEAD)"
			NEKO_BOOTSTRAP_PULLED=1 exec "${HOME}/.dotfiles/conf.d/neko/bin/neko-bootstrap" "$@"
		fi
	else
		echo "[warn] dotfiles pull skipped (offline, local commits, or no upstream)"
	fi
fi

# The checkout directly: on a fresh PVC the ~/.config/mise link doesn't exist yet.
export MISE_CONFIG_DIR="${HOME}/.dotfiles"

# mise's [env] for this script (PROTON_PASS_KEY_PROVIDER=fs above all). --shell
# bash is load-bearing: from fish, bare `mise env` emits `set -gx`, on which dash
# exits outright, past the `|| true`.
eval "$("$MISE" env --shell bash 2>/dev/null)" || true

# Pick a mode, then bootstrap exactly once:
#   secrets  live Proton Pass session (PASS_CLI_PAT logs in without a TTY)
#   fresh    no session, but no secret-derived content to lose either: the test
#            is the ssh Host block / a non-empty kubeconfig, not the files
#            (~/.ssh/config always exists after one run)
#   protect  no session and secrets on disk: skip dotfiles, or they render empty
FNOX="$("$MISE" which fnox 2>/dev/null || true)"
if [ -n "$FNOX" ] && [ -x "$FNOX" ] &&
	DOTFILES_NO_LOGIN=1 "${HOME}/.dotfiles/scripts/pass-preflight"; then
	MODE=secrets
elif ! grep -q "^Host " "${HOME}/.ssh/config" 2>/dev/null && [ ! -s "${HOME}/.kube/main.yaml" ]; then
	MODE=fresh
else
	MODE=protect
fi

# --skip-dirty: one repo with uncommitted work would fail the whole run.
# --force-dotfiles: fish writes its own config.fish on first start.
case "$MODE" in
secrets) set -- "$FNOX" --if-missing error exec -c fnox.toml -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty ;;
fresh) set -- "$MISE" bootstrap --yes --force-dotfiles --skip-dirty ;;
protect) set -- "$MISE" bootstrap --yes --skip dotfiles --skip-dirty ;;
esac

if ! timeout 900 "$@"; then
	echo "[error] bootstrap failed in mode '$MODE' — see above"
	command -v notify-send >/dev/null 2>&1 &&
		notify-send -u critical "neko-bootstrap failed" "see $LOG" || true
	exit 1
fi
case "$MODE" in
secrets) echo "[ok] bootstrap applied with secrets" ;;
fresh) echo "[ok] bootstrap applied without secrets (set PASS_CLI_PAT, or \`pass-cli login\` then \`mise run apply\`)" ;;
protect) echo "[warn] no Proton Pass session — dotfiles SKIPPED to protect existing copies" ;;
esac
