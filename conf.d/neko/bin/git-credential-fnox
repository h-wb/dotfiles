#!/bin/sh
# git credential helper: the GitHub token from Proton Pass via fnox, no copy on
# disk. fnox's daemon keeps it in memory so only the first call is slow.
[ "${1:-}" = get ] || exit 0
export PROTON_PASS_KEY_PROVIDER="${PROTON_PASS_KEY_PROVIDER:-fs}"
t="${GH_TOKEN:-$(FNOX_DAEMON=on FNOX_NON_INTERACTIVE=1 "$HOME/.local/share/mise/shims/fnox" \
	-c "$HOME/.dotfiles/fnox.toml" get GH_TOKEN 2>/dev/null)}"
[ -n "$t" ] && printf 'username=x-access-token\npassword=%s\n' "$t"
